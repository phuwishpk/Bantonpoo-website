# ค่าสำหรับ npm run deploy — คัดลอกไฟล์นี้เป็น .env.deploy.local แล้วใส่รหัสผ่าน
# (.env.deploy.local อยู่ใน .gitignore ไม่ถูก commit)

# รหัสผ่านของ system user ตั้งที่ Plesk → Hosting → System user's credentials
FTP_PASSWORD=

# ---- ค่าด้านล่างมีค่าตั้งต้นแล้ว เปิดใช้เมื่อจำเป็น ----

# ถ้าขึ้นว่าตรวจใบรับรอง TLS ไม่ผ่าน ให้เปิดบรรทัดนี้ (ยังเข้ารหัสอยู่ แค่ไม่ตรวจชื่อเครื่อง)
# FTP_INSECURE_TLS=1

# ลดจำนวนการเชื่อมต่อพร้อมกัน ถ้าโฮสต์ตัดการเชื่อมต่อระหว่างอัปโหลด
# FTP_WORKERS=2

# FTP_HOST=thsv25.hostatom.com
# FTP_USER=phuwishs

# เมื่อเปิดเว็บจริง: เปลี่ยนโดเมน และตั้ง DEPLOY_NOINDEX=0 ให้ Google เก็บดัชนีได้
# DEPLOY_SITE_URL=https://bantonpoo.phuwish.com
# DEPLOY_NOINDEX=1
